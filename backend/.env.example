# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (Replace with your MongoDB Atlas connection string in production)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/campus_complaints?retryWrites=true&w=majority

# Authentication Configuration (Generate a strong 32+ character random secret)
JWT_SECRET=b379a076ecfb16def863a2162b11c7fac0891e9daf318dcaaf133720a2e00c36
JWT_EXPIRES_IN=7d

# CORS Configuration (Set to your deployed frontend domain, e.g., https://your-app.vercel.app)
CORS_ORIGIN=https://campus-complaint-system-frontend.vercel.app

# Initial Admin Seeding (Used by npm run seed:admin)
ADMIN_NAME=Campus Administrator
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=Admin@123
ADMIN_DEPARTMENT=Campus Administration

# Email Notification Configuration (Nodemailer)
# Set these in Render Environment Variables with your actual credentials.
# For Gmail, use an App Password (16 letters). Never use your personal password.
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password
EMAIL_FROM="Campus Complaint System" <your-email@gmail.com>

# Frontend URL (Used for clickable links in email templates)
FRONTEND_URL=https://campus-complaint-system-frontend.vercel.app
